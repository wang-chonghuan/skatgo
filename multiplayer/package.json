{
  "name": "skatgo-multiplayer",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node --env-file-if-exists=.env dist/server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --env-file-if-exists=.env --import tsx --test test/*.test.ts",
    "check": "npm run typecheck && npm run build && npm test"
  },
  "dependencies": {
    "@colyseus/core": "0.18.17",
    "@colyseus/schema": "5.0.34",
    "@colyseus/ws-transport": "0.18.4",
    "express": "^5.1.0",
    "pg": "^8.16.3",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@colyseus/sdk": "0.18.4",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
